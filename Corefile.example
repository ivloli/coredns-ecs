. {
    ecs_normalizer {
        ip2region_db  /data/ip2region/ip2region_v4.xdb
        ip2region_db_v6 /data/ip2region/ip2region_v6.xdb
        nacos_addr    nacos:8848
        nacos_namespace coredns
        nacos_group   subnet_mapping
        nacos_data_id subnet_map
        nacos_data_id_v6 subnet_map_v6
        prefix_length 24
    }

    forward . 114.114.114.114:53 {
        force_tcp
    }

    prometheus :9153
    log
    errors
}
