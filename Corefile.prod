.:8053 {
    log
    errors

    forward . tls://139.159.195.20:10530 {
        tls_servername b-f3.ufaei.com
        policy sequential
        max_fails 2
    }

      ecs_normalizer {
          ip2region_db  /var/lib/coredns-ecs/ip2region/ip2region_v4.xdb
          nacos_addr    139.159.195.20:8848
          nacos_namespace   scloud-prod
          nacos_group   subnet_mapping
          nacos_data_id subnet_map
          nacos_username scloud-admin
          nacos_password 2a958ec104323d2a9374675154d1a4fc
          prefix_length 24
          # Prefetch strategy
          cache_prefetch_mode  active   # request | active
          cache_prefetch_ahead 5s
          cache_prefetch_scan  1s        # only used when mode=active
          cache_max_cost_mb 256         # Ristretto 最大容量（MB）

          # 本地 HTTP 手动重载 XDB（默认关闭）
          xdb_reload_http_addr 127.0.0.1:18181
          xdb_reload_http_path /ecs_normalizer/reload-xdb
      }

      prometheus 0.0.0.0:29159
    loop
}

