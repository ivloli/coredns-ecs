[Unit]
Description=CoreDNS with ECS Normalizer
Documentation=https://coredns.io
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/coredns-ecs -conf /etc/coredns-ecs/Corefile
WorkingDirectory=/etc/coredns-ecs
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coredns-ecs

[Install]
WantedBy=multi-user.target
